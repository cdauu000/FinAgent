# Development configuration only. Do not add real keys to version control.
FINAGENT_ENV=development
FINAGENT_DATABASE_URL=postgresql://finagent:finagent_dev_only@localhost:5432/finagent
FINAGENT_REDIS_URL=redis://localhost:6379/0
FINAGENT_PAID_FALLBACK=false
FINAGENT_DEFAULT_TIER=private
FINAGENT_PRIVATE_ARTIFACT_RETENTION_DAYS=30
FINAGENT_GROQ_RUNTIME_API_KEY=
FINAGENT_GOOGLE_AI_STUDIO_RUNTIME_API_KEY=
FINAGENT_OPENAI_RUNTIME_API_KEY=
FINAGENT_DEEPSEEK_RUNTIME_API_KEY=
# Separate development/teacher credentials; runtime must never read these.
FINAGENT_GROQ_DEVELOPMENT_API_KEY=
FINAGENT_GOOGLE_AI_STUDIO_DEVELOPMENT_API_KEY=
# Provider private retention bound has no implicit default; unset means local-only.
FINAGENT_PRIVATE_MAX_RETENTION_DAYS=

